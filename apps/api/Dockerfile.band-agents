FROM node:22-bookworm-slim

# Codex permission profiles use bubblewrap for OS-enforced command isolation on
# Linux. Keep the worker image explicit instead of depending on host packages.
RUN apt-get update \
  && apt-get install -y --no-install-recommends bubblewrap ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV PATH="/app/node_modules/.bin:${PATH}"

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN npm ci --include=dev

COPY apps/api apps/api
COPY packages/contracts packages/contracts
RUN npm run db:generate -w @zero-human/api \
  && npm run build -w @zero-human/contracts \
  && npm run build -w @zero-human/api

CMD ["npm", "run", "start:band-agents", "-w", "@zero-human/api"]
